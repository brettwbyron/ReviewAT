# GitHub Configuration for ReviewAT GitHub Application
# Copy this file to .env and fill in your actual values

# Your GitHub username
VITE_GITHUB_OWNER=your-github-username
# The repository name
VITE_GITHUB_REPO=ReviewAT
# GitHub Personal Access Token with 'Contents: Read and write' permission. Create at: https://github.com/settings/tokens
VITE_GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The branch to use for data
VITE_GITHUB_BRANCH=data
# Password used for accessing the admin side of the app
VITE_ADMIN_PASSWORD=your-secure-admin-password
